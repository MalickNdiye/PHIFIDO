############### Functions ###################################################
def concat_tables(tables_list, skip=0, delimiter="\t", head=0, names=False, names_list=[], add={}):
    # this function concatenates a list of tables
    # tables_list: list of tables to concatenate
    # returns: concatenated table
    df_list=[]
    count=0
    for t in tables_list:
        
        if os.path.getsize(t) <= 1:
            continue

        # open file skipping "skip lines" and adding header
        if names:
            df=pd.read_csv(t,  skiprows=skip, sep=delimiter, header=head, names=names_list)
        else:
            df=pd.read_csv(t,  skiprows=skip, sep=delimiter, header=head)
         
         # "add" is a dictionary with columns to add
         # key: column name, value: list of values to add, each value correspond to a daframe in tables_list
        for key, value in add.items():
            df[key]=value[count]
        count+=1

        df_list.append(df)

    df=pd.concat(df_list)
    
    return(df)

def get_reads(sample):
    # within sample there is two section, Ampliphage and coEx, and whithin each section there is the samples with R1 and R2
    # returns the R1 and R2 files for a given sample
    for section in config["samples"]:
        if sample in config["samples"][section]:
            return(config["samples"][section][sample])
    return(None)
    
