rule assemble_metagenomes:
    """
    Assemble filtered reads into contigs using MEGAHIT.
    """
    input:
        R1 = "../data/trimmed_reads/{sample}_R1_paired.fastq.gz",
        R2 = "../data/trimmed_reads/{sample}_R2_paired.fastq.gz"
    output:
        outdir = directory("../results/assembly/viral/{sample}_viral_assembly")
    threads: 12
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 250000,
        runtime = "3h"
    log:
        "logs/assembly/filt/{sample}_assembly_viral.log"
    benchmark:
        "logs/assembly/filt/{sample}_assemble_viral.benchmark"
    conda:
        "envs/assembly.yaml"
    shell:
        "megahit -1 {input.R1} -2 {input.R2} -o {output} -m 0.8 -t {threads} --presets meta-sensitive"    

rule run_vibrant:
    """
    Identify lytic viruses in assemblies using VIBRANT.
    """
    input:
        assembly = "../results/assembly/viral/{sample}_viral_assembly"
    output:
        outdir = directory("../results/viral_identification/vibrant/{sample}")
    log:
        "logs/viral_identification/vibrant/{sample}_vibrant.log"
    params:
        db = "../resources/databases/databases"
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 100000,
        runtime = "1h"
    threads: 8
    conda:
        "envs/vibrant.yaml"
    shell:
        "VIBRANT_run.py -i {input.assembly}/final.contigs.fa -folder {output.outdir} -d {params.db} -t {threads};"

rule run_genomad:
    """
    Identify viruses and plasmids using GeNomad.
    """
    input:
        bifidos = lambda wildcards: config["BiCom"][wildcards.bifi]
    output:
        dir = directory("../results/viral_identification/genomad/genomad_{bifi}/")
    log:
        "logs/viral_identification/genomad/{bifi}_genomad.log"
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 100000,
        runtime = "1h"
    threads: 8
    conda:
        "envs/genomad.yaml"
    params:
        db = config["GENOMAD_DB"]
    shell:
        "genomad end-to-end -t {threads} {input} {output} {params.db}"

# --- Parsing & Aggregation ---

rule parse_vibrant:
    """
    Convert a single sample's raw VIBRANT output directory into a tidy
    per-sample summary table of predicted viral contigs.
    """
    input:
        "../results/viral_identification/vibrant/{sample}"
    output:
        temp("../results/viral_identification/vibrant/summary/{sample}_vibrant_summary.tsv")
    log:
        "logs/viral_identification/vibrant/{sample}_summary.log"
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 1000,
        runtime = "30m"
    threads: 1
    conda:
        "envs/base_R_env.yaml"
    shell:
        "Rscript scripts/viral_identification/parse_vibrant_output.R -d {input} -o {output}"

rule parse_genomad:
    """
    Convert a single Bifidobacterium genome's raw GeNomad output into a
    tidy summary table and extract the predicted prophage sequences.
    """
    input:
        "../results/viral_identification/genomad/genomad_{bifi}"
    output:
        tab = temp("../results/viral_identification/genomad/summary/{bifi}_genomad_summary.tsv"),
        fasta = "../results/viral_identification/genomad/summary/genomad_{bifi}_prophages.fasta"
    log:
        "logs/viral_identification/genomad/{bifi}_summary.log"
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 1000,
        runtime = "10m"
    threads: 1
    conda:
        "envs/base_R_env.yaml"
    shell:
        "Rscript scripts/viral_identification/parse_genomad_output.R -d {input} -o {output.tab} -f {output.fasta}"

rule aggregate_vibrant_summaries:
    """
    Combine per-sample VIBRANT summaries and per-genome GeNomad summaries
    into a single viral-identification summary table.
    """
    input:
        all_tabs = expand("../results/viral_identification/vibrant/summary/{sample}_vibrant_summary.tsv",
                          sample=[s for grp in config["samples"].values() for s in grp.keys()]),
        all_genomad = expand("../results/viral_identification/genomad/summary/{bifi}_genomad_summary.tsv",
                             bifi=config["BiCom"])
    output:
        summ_tab = "../results/viral_identification/vibrant/summary/vibrant_identification_summary.tsv"
    log:
        "logs/viral_identification/vibrant/all_vibrant_summary.log"
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 1000,
        runtime = "10m"
    threads: 1
    run:
        df = concat_tables(input.all_tabs, head="infer")
        genomad_df = concat_tables(input.all_genomad, head="infer")
        df = pd.concat([df, genomad_df], axis=0)
        df.to_csv(output.summ_tab, sep="\t", index=False)


