# ==============================================================================
# SECTION 1: Data Validation & Preprocessing
# This section handles raw read QC, trimming, and host filtering.
# ==============================================================================

rule rawreads_trimming:
    """
    Trim adapters and low-quality bases using Trimmomatic.
    """
    input:
        R1 = lambda wildcards: get_reads(wildcards.sample)[0],
        R2 = lambda wildcards: get_reads(wildcards.sample)[1]
    output:
        R1_paired = "../data/trimmed_reads/{sample}_R1_paired.fastq.gz",
        R2_paired = "../data/trimmed_reads/{sample}_R2_paired.fastq.gz",
        R1_unpaired = "../data/trimmed_reads/{sample}_R1_unpaired.fastq.gz",
        R2_unpaired = "../data/trimmed_reads/{sample}_R2_unpaired.fastq.gz"
    threads: 8
    params:
        nextera = "../data/references/short_RefSeqs/NexteraPE-PE.fa",
        q = 25,
        min_length = 40
    log:
        "logs/data_validation/trimming/{sample}_trimming.log"
    conda:
        "envs/trimmomatic.yaml"
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 6000,
        runtime = "1h"
    shell:
        "trimmomatic PE -phred33 -threads {threads} {input.R1} {input.R2} "
        "{output.R1_paired} {output.R1_unpaired} {output.R2_paired} {output.R2_unpaired} "
        "ILLUMINACLIP:{params.nextera}:2:30:10 "
        "LEADING:{params.q} TRAILING:{params.q} MINLEN:{params.min_length}"

rule filter_bifido_paired:
    """
    Filter out host (Bifidobacterium) reads using BBSplit to keep only non-host (viral/other) reads.
    """
    input:
        R1 = "../data/trimmed_reads/{sample}_R1_paired.fastq.gz",
        R2 = "../data/trimmed_reads/{sample}_R2_paired.fastq.gz",
        ref_bifido = expand("../data/references/Bifido_genomes/{genome}.fasta", genome=config["BiCom"])
    output: 
        unmapped_R1 = "../data/filtered_reads/{sample}_R1_filt.fastq.gz",
        unmapped_R2 = "../data/filtered_reads/{sample}_R2_filt.fastq.gz",
        refstats = "../results/data_validation/filtered_reads/filt_mappings_stats/{sample}_refstats.out",
        bincov = "../results/data_validation/filtered_reads/filt_mappings_stats/coverage/{sample}_bincov.txt"
    conda:
        "envs/mapping.yaml"
    threads: 10
    params:
        ref_bifi = lambda w, input: ",".join(input.ref_bifido),
        dir = "../results/data_validation/filtered_reads/discarded/{sample}_discarded/",
        xmx = "50g"
    log:
        "logs/data_validation/filter_bifido_reads/{sample}_HF.log"
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 100000,
        runtime = "30m"
    shell:
        "bbsplit.sh in1={input.R1} in2={input.R2} ref={params.ref_bifi} "
        "basename={params.dir}/{wildcards.sample}_HF_discarded_%.sam "
        "refstats={output.refstats} rebuild=f nodisk=t "
        "outu1={output.unmapped_R1} outu2={output.unmapped_R2} nzo=f -Xmx{params.xmx} threads={threads} "
        "bincov={output.bincov}"

rule parse_filtering_refstats:
    """
    Aggregate host filtering statistics (reads removed).
    """
    input:
        files = expand("../results/data_validation/filtered_reads/filt_mappings_stats/{sample}_refstats.out", 
                       sample=[s for grp in config["samples"].values() for s in grp.keys()])
    output:
        "../results/data_validation/filtered_reads/filt_mappings_stats/bifido_reads_filtering_refstats.txt"
    threads: 2
    log:
        "logs/data_validation/HF/HF_refstats_parsing.log"
    params:
        sams = expand("{sample}", sample=config["samples"])
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 500,
        runtime = "15m"
    run:
        df = concat_tables(input.files, skip=0, delimiter="\t", head=0, names_list=[], add={"sample":params.sams})
        df.to_csv(output[0], sep="\t", index=False)

# --- Read Counting ---

rule count_reads_qc:
    """
    Count reads at Pre-Trimming, Post-Trimming, and Post-Filtering stages.
    """
    input:
        preT = lambda wildcards: get_reads(wildcards.sample)[0],
        postT = "../data/trimmed_reads/{sample}_R1_paired.fastq.gz",
        postF = "../data/filtered_reads/{sample}_R1_filt.fastq.gz"
    output:
        temp("../results/data_validation/QC/{sample}_read_count.txt")
    log:
        "logs/data_validation/QC/read_count/{sample}_read_count.log"
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 4000,
        runtime = "30m"
    shell:
        "touch {output}; "
        "(./scripts/data_validation/count_reads.sh {input.preT} {input.postT} {input.postF} {output} {wildcards.sample}) 2>{log}"

rule count_reads_summary:
    """
    Aggregate read count statistics and merge with sample metadata.
    """
    input:
        sams = expand("../results/data_validation/QC/{sample}_read_count.txt", 
                      sample=[s for grp in config["samples"].values() for s in grp.keys()]),
        metadata = config["sample_metadata"]
    output:
        "../results/data_validation/QC/read_count.tsv"
    log:
        "logs/data_validation/QC/read_count/summary_read_count.log"
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 4000,
        runtime = "30m"
    run:
        df = concat_tables(input.sams, skip=0, delimiter="\t", head="infer")
        metadata_df = pd.read_csv(input.metadata, sep=",")
        df = pd.merge(df, metadata_df, left_on="sample", right_on="SampleID", how="left")
        df.to_csv(output[0], sep="\t", index=False)


