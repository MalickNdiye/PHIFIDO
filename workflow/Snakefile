"""
Snakemake Pipeline for Metagenomic Viral Analysis
=================================================
This pipeline performs the following steps:
1. Data Validation & Preprocessing (QC, Trimming, Host Filtering)
2. Viral Assembly & Identification (Megahit, VIBRANT, Genomad)
3. Viral Contig Processing (Aggregation, Splitting)
4. Dereplication (dRep) & Representative Selection
5. Downstream Analysis (Pangenomics, inStrain)

This is the main entry point: it defines shared helper functions and the
final target rule ("rule all"), then pulls in the other rule files (each
covering one stage of the pipeline) via "include" statements below.
"""

configfile: "../config/config.yaml"

# ==============================================================================
# SETUP: Variables & Helper Functions
# ==============================================================================

import os
import pandas as pd
import numpy as np

# Bacterial (Bifidobacterium) genome QC, taxonomy, annotation, pangenomics
# and phylogeny (Section: Host genome characterization).
include: "Host_analysis.smk"

def concat_tables(tables_list, skip=0, delimiter="\t", head=0, names=False, names_list=[], add={}):
    """
    Concatenates a list of tables into a single DataFrame.
    """
    df_list = []
    count = 0
    for t in tables_list:
        if os.path.getsize(t) <= 1:
            continue

        # Open file skipping "skip lines" and adding header
        if names:
            df = pd.read_csv(t, skiprows=skip, sep=delimiter, header=head, names=names_list)
        else:
            df = pd.read_csv(t, skiprows=skip, sep=delimiter, header=head)
        
        # "add" is a dictionary with columns to add
        # key: column name, value: list of values to add corresponding to tables_list
        for key, value in add.items():
            df[key] = value[count]
        count += 1

        df_list.append(df)

    if df_list:
        df = pd.concat(df_list)
    else:
        df = pd.DataFrame() # Return empty if no valid tables
    
    return df

def get_reads(sample):
    """
    Retrieves R1 and R2 file paths for a given sample from the config.
    """
    for section in config["samples"]:
        if sample in config["samples"][section]:
            return config["samples"][section][sample]
    return None

def get_files_commas(path, sep=",", remove_hidden=True):
    """
    Returns a comma-separated string of files in a directory.
    """
    file_l = os.listdir(path)
    if remove_hidden:
        file_l = [f for f in file_l if not f.startswith(".")]

    file_l2 = [os.path.join(path, f) for f in file_l]
    out = sep.join(file_l2)
    return out

