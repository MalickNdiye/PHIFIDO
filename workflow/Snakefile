        genomes="../results/vMAGs/dereplication/dRep_average"
    output:
       tab=temp("../results/mapping/{sample}_community_mapping.txt")
    resources:
        account="pengel_beemicrophage",
        runtime="30m",
        mem_mb = 50000
    threads: 20
    log:
        "logs/mapping/{sample}_map.log"
    conda:
        "envs/coverm.yaml"
    shell:
        """
        coverm genome -1 {input.R1} -2 {input.R2} -d {input.genomes}/dereplicated_genomes -x .fasta \
            --mapper minimap2-sr --min-read-percent-identity 92 -m length count rpkm trimmed_mean covered_bases \
            variance --min-covered-fraction 0 -t {threads} -o {output.tab}
        """
        
rule aggregate_coverm:
    input:
        expand("../results/mapping/{sample}_community_mapping.txt", sample=config["samples"])
    output:
        all="../results/mapping/all_viral_community_mapping.txt"
    resources:
        account="pengel_beemicrophage",
        runtime="10m",
        mem_mb = 8000
    threads: 1
    log:
        "logs/mapping/concat_mapping_data.log"
    run:
        import pandas as pd
        
        samples=list(config["samples"].keys())
        dict_samples={"sample":samples}

        df=concat_tables(input, skip=0, delimiter="\t", 
            head=0, names=True, names_list=["genome", "length", "count", "rpkm","trimmed_mean", "covered_bases", "variance" ],
            add=dict_samples)
        df.to_csv(output.all, sep="\t", index=False)