        "logs/vMAGs/dereplication/drep_average.log"
    benchmark:
        "logs/vMAGs/dereplication/drep_average.benchmark"
    conda:
        "envs/drep_env.yaml"
    shell:
        "dRep dereplicate {output.drep} -g {input.dir}/* --S_algorithm ANImf -pa 0.5 -sa 0.95 -nc 0.85 -l 5000 -N50W 0 -sizeW 1 --clusterAlg average --ignoreGenomeQuality -p {threads}"

