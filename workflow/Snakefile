def get_generated_files(wildcards):
    # Use `get()` to retrieve the directory created by the checkpoint
    checkpoint_output = checkpoints.split_viral_contigs.get().output[0]
    # List files in the directory to use them as input for subsequent rules
    return glob_wildcards(f"{checkpoint_output}/{{file}}.fasta").file

def read_file_list():
    with open("file_list.txt") as f:
        return [line.strip() for line in f]


