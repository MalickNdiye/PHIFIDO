# --- Dynamic File Handling Functions ---

def get_representative_genomes_average(wildcards):
    """
    Retrieves the list of representative genomes from the dRep summary table.
    This function is used to dynamically determine inputs for subsequent steps.
    """
    import pandas as pd
    # Use .get() to access checkpoint output
    summary_file = checkpoints.parse_dRep_viruses_average.get().output.tab
    
    if not os.path.exists(summary_file):
        return []  # Return empty list while Snakemake resolves DAG
    
    df = pd.read_csv(summary_file, sep="\t")
    rep_genomes = df.loc[df["representative"].astype(str).str.upper() == "TRUE", "genome"].tolist()
    return rep_genomes

def get_avg_representative_fasta(wildcards):
    """
    Constructs file paths for representative genomes identified by dRep.
    """
    checkpoint_output = checkpoints.split_viral_contigs.get(**wildcards).output.dir
    rep_genomes = get_representative_genomes_average(wildcards)
    
    # Build full paths
    aveg_rep_paths = [os.path.join(checkpoint_output, f"{g}.fasta") for g in rep_genomes]
    return aveg_rep_paths


