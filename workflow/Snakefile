rule aggregate_vibrant_summaries:
    input:
        all_tabs=expand("../results/viral_identification/vibrant/summary/{sample}_vibrant_summary.tsv", sample=[s for grp in config["samples"].values() for s in grp.keys()]),
        all_genomad=expand("../results/viral_identification/genomad/summary/{bifi}_genomad_summary.tsv", bifi=config["BiCom"])
    output:
        summ_tab="../results/viral_identification/vibrant/summary/vibrant_identification_summary.tsv"
    log:
        "logs/viral_identification/vibrant/all_vibrant_summary.log"
    resources:
        account="pengel_beemicrophage",
        mem_mb= 1000,
        runtime = "10m"
    threads: 1
    run:
        import pandas as pd
        df=concat_tables(input.all_tabs, head="infer")
        genomad_df=concat_tables(input.all_genomad, head="infer")
        df=pd.concat([df, genomad_df], axis=0)
        df.to_csv(output.summ_tab, sep="\t", index=False)

