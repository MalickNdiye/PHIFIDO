checkpoint split_viral_contigs:
    """
    Checkpoint: Splits the aggregated High-Quality (HQ) viral contigs into individual files.
    This enables dynamic branching for subsequent dereplication steps.
    """
    input:
        HQ = "../results/assembly/viral/all_HQ_viral_contigs.fasta"
    output:
        dir = directory("../results/assembly/viral/single_genomes/"),
        list_genomes = "../results/assembly/viral/single_genomes_list.txt"
    resources:
        account = "pengel_beemicrophage",
        runtime = "15m",
        mem_mb = 8000
    threads: 1
    log:
        "logs/viral_identification/split_contigs.log"
    shell:
        """
        python scripts/split_assembly.py -f {input.HQ} -d {output.dir}
        ls {output.dir}/*.fasta > {output.list_genomes}
        """

