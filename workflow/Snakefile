        runtime= "40m"
    params:
        db="/users/mndiaye1/beemicrophage_dir/PHOSTER/workflow/resources/default_DBs/230228_costum_kraken2db_new"
    shell:
        "kraken2 --use-names --threads {threads} --db {params.db} --fastq-input --report {output.rep}  --gzip-compressed --paired {input.R1} {input.R2}  > {output.tab}"

