rule dereplicate_viral_contigs_average:
    """
    Dereplicate viral genomes using dRep with 'average' clustering algorithm.
    """
    input:
        dir = "../results/assembly/viral/single_genomes/"
    output:
        drep = directory("../results/vMAGs/dereplication/dRep_average")
    resources:
        account = "pengel_beemicrophage",
        runtime = "3h",
        mem_mb = 200000
    threads: 20
    log:
        "logs/vMAGs/dereplication/drep_average.log"
    benchmark:
        "logs/vMAGs/dereplication/drep_average.benchmark"
    conda:
        "envs/drep_env.yaml"
    shell:
        "dRep dereplicate {output.drep} -g {input.dir}/* --S_algorithm ANImf "
        "-pa 0.5 -sa 0.95 -nc 0.85 -l 5000 -N50W 0 -sizeW 1 "
        "--clusterAlg average --ignoreGenomeQuality -p {threads}"

checkpoint parse_dRep_viruses_average:
    """
    Checkpoint: Parse dRep results to identify representative genomes (average clustering).
    """
    input:
        drep = "../results/vMAGs/dereplication/dRep_average",
        metadata = "../results/vMAGs/QC/Checkv"
    output:
        tab = "../results/vMAGs/dereplication/dRep_summary_average.tsv"
    resources:
        account = "pengel_beemicrophage",
        runtime = "10m",
        mem_mb = 8000
    threads: 1
    log:
        "logs/vMAGs/dereplication/parse_drep_average.log"
    conda:
        "envs/base_R_env.yaml"
    shell:
        "Rscript scripts/vMAGs_handling/parse_drep_viruses.R -i {input.drep} "
        "-m {input.metadata}/quality_summary.tsv -o {output.tab}"

