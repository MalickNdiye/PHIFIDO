rule aggragate_viral_contigs:
    """
    Pool all viral contigs (metagenomic vMAGs, prophages, and isolates) into one file.
    """
    input:
        vmags = expand("../results/assembly/viral/{sample}_viral_contigs.fasta", 
                       sample=[s for grp in config["samples"].values() for s in grp.keys()]),
        prophages = expand("../results/viral_identification/genomad/summary/genomad_{bifi}_prophages.fasta", 
                           bifi=config["BiCom"]),
        isolates = "../data/references/Honeybee_phage_isolates/Isolated_phages_genomes.fasta"
    output:
        "../results/assembly/viral/all_viral_contigs.fasta"
    log:
        "logs/viral_identification/aggregate_get_viral_contigs.log"
    resources:
        account = "pengel_beemicrophage",
        mem_mb = 10000,
        runtime = "10m"
    threads: 1
    shell:
        "cat {input.vmags} > {output}; "
        "cat {input.prophages} >> {output}; "
        "cat {input.isolates} >> {output}"

